<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- DNS diagnostics need to open a socket to dns.kuies.tw. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed to read the underlying network and react to Wi-Fi / mobile data switches. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service that keeps the VPN foundation alive (Android 8+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      Android 14 (API 34) requires every foreground service to declare a type and
      hold the matching permission. A DNS-based blocker is not one of the dedicated
      types, so it is declared as "specialUse" with a subtype description.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13 (API 33) requires this to show the ongoing VPN notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the app be told about a restart so it can offer to restore protection (best effort). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Android 8+ requires the user's consent before an app can hand an APK to the system installer.
      The permission only opens the system confirmation flow; it never installs silently.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      The per-app page lists user-visible launcher apps. Query only that intent instead of requesting
      QUERY_ALL_PACKAGES; apps without a launcher entry are intentionally not offered.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KuiesBlock">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KuiesBlock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The downloaded APK stays in the app's private cache. FileProvider hands the system installer
          a one-time readable URI only after the download, checksum and signature checks succeeded.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!--
          VpnService is bound by the system, so it must not be exported to other
          apps and must be protected by BIND_VPN_SERVICE.
        -->
        <service
            android:name=".vpn.KuiesVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/vpn_service_label"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_vpn_foundation_dns_blocking" />
        </service>

        <!--
          Best-effort protection restore after a restart, on top of the system's Always-on VPN (which
          is the reliable mechanism and needs nothing here).

          Exported because BOOT_COMPLETED is delivered to manifest receivers by component name. The
          receiver acts on that action only, is idempotent, and asks BootAutostartPolicy first, so a
          third party triggering it can at most start the user's own VPN — it can never change a
          setting, open a dialog or stop another VPN.
        -->
        <receiver
            android:name=".vpn.BootProtectionReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
