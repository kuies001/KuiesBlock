<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy first: KuiesBlock keeps its settings and DNS configuration on-device.
  Nothing is uploaded, so both cloud backup and device transfer exclude the app's
  preference files. Keep this in sync with backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="kuies_block_settings.xml" />
        <exclude domain="sharedpref" path="kuies_block_dns.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="kuies_block_settings.xml" />
        <exclude domain="sharedpref" path="kuies_block_dns.xml" />
    </device-transfer>
</data-extraction-rules>
